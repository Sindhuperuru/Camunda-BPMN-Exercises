          <text>loanAmount</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="riskTier" name="riskTier" typeRef="string" />
      <output id="OutputClause_1l06dz1" label="requiresManualReview" name="requiresManualReview" typeRef="boolean" />
      <rule id="DecisionRule_02i9wt1">
        <inputEntry id="UnaryTests_1dbnt0r">
          <text>&gt;= 750</text>
        </inputEntry>
        <inputEntry id="UnaryTests_1wifpiz">
          <text>&lt;= 50000</text>
