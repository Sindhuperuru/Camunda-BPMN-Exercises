  <bpmn:process id="Process_1h3on29" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_1mia8zg</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_1j2ozd1" name="Submit Loan Application">
      <bpmn:incoming>Flow_1mia8zg</bpmn:incoming>
      <bpmn:outgoing>Flow_0x9shhs</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1mia8zg" sourceRef="StartEvent_1" targetRef="Activity_1j2ozd1" />
    <bpmn:sequenceFlow id="Flow_0x9shhs" sourceRef="Activity_1j2ozd1" targetRef="Activity_1t0a2kd" />
    <bpmn:businessRuleTask id="Activity_1t0a2kd" name="Evaluate Loan Risk">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="evaluate-loan-risk" resultVariable="riskDecision" />
        <zeebe:ioMapping>
          <zeebe:output source="=riskDecision.riskTier" target="riskTier" />
          <zeebe:output source="=riskDecision.requiresManualReview" target="requiresManualReview" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0x9shhs</bpmn:incoming>
      <bpmn:outgoing>Flow_1nchxdt</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_0wbtvck">
      <bpmn:incoming>Flow_1nchxdt</bpmn:incoming>
      <bpmn:outgoing>Flow_0m3lz9m</bpmn:outgoing>
      <bpmn:outgoing>Flow_1bf39wx</bpmn:outgoing>
      <bpmn:outgoing>Flow_0sr2g9x</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1nchxdt" sourceRef="Activity_1t0a2kd" targetRef="Gateway_0wbtvck" />
    <bpmn:sequenceFlow id="Flow_0m3lz9m" sourceRef="Gateway_0wbtvck" targetRef="Activity_15fpis4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskDecision.riskTier = "LOW"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_15fpis4" name="Auto-Approve and Disburse">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-approve" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0m3lz9m</bpmn:incoming>
      <bpmn:outgoing>Flow_1w07daf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1bf39wx" sourceRef="Gateway_0wbtvck" targetRef="Activity_112l7st">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskDecision.riskTier = "MEDIUM" or riskDecision.requiresManualReview = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_112l7st" name="Underwriter Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="underwriter-review-form" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bf39wx</bpmn:incoming>
      <bpmn:outgoing>Flow_1000xdd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_0sr2g9x" sourceRef="Gateway_0wbtvck" targetRef="Activity_066gkyg">
      <bpmn:extensionElements />
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=riskDecision.riskTier = "HIGH" and riskDecision.requiresManualReview = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_066gkyg" name="Auto-Reject Notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-reject notification" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0sr2g9x</bpmn:incoming>
      <bpmn:outgoing>Flow_1xp9mvv</bpmn:outgoing>
    </bpmn:serviceTask>
